# ============================================
# HPE - High Performance Evaluator .gitignore
# ============================================

# --- 设计文档 ---
# 排除所有设计文档，只保留README
docs/
*.md
!README.md

# --- 日志文件 ---
*.log
*-log.txt
debug_log.txt
run_log.txt

# --- 测试程序 ---
test_*.py
test_*.txt

# --- 配置文件（含API密钥） ---
.env

# --- Git指令步骤文件（自身排除） ---
git_setup_guide.md

# --- Python 缓存 ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/

# --- 虚拟环境 ---
venv/
.venv/
env/

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo

# --- 操作系统 ---
.DS_Store
Thumbs.db