{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpe.local/schemas/v2/review.schema.json",
  "title": "HPE Reviewer Report",
  "description": "One reviewer, one round. Round 0 is independent; round >= 1 must include issue_updates, new_issues and position_changes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "paper_id",
    "reviewer_id",
    "persona",
    "round",
    "mode",
    "recommendation",
    "score",
    "confidence",
    "summary",
    "strengths",
    "issues",
    "questions",
    "missing_evidence",
    "coverage"
  ],
  "properties": {
    "schema_version": {
      "const": "hpe/v2"
    },
    "paper_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_id": {
      "type": "string",
      "pattern": "^R[0-9]{1,2}$"
    },
    "reviewer_label": {
      "type": "string",
      "maxLength": 40
    },
    "persona": {
      "enum": [
        "methodology",
        "experiments",
        "novelty",
        "reproducibility",
        "devils_advocate",
        "practitioner"
      ]
    },
    "round": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "mode": {
      "enum": [
        "independent",
        "cross_review",
        "final"
      ]
    },
    "recommendation": {
      "enum": [
        "accept",
        "minor_revision",
        "major_revision",
        "reject"
      ]
    },
    "score": {
      "$ref": "#/$defs/score"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "claim",
          "evidence",
          "importance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R[0-9]{1,2}-S[0-9]{1,3}$"
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/evidence"
            }
          },
          "importance": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "issue_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_id",
          "status",
          "rationale"
        ],
        "properties": {
          "issue_id": {
            "type": "string",
            "pattern": "^(R[0-9]{1,2}-I[0-9]{1,3}|I-[0-9]{3})$"
          },
          "status": {
            "enum": [
              "resolved",
              "partially_resolved",
              "disputed",
              "open",
              "withdrawn"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            }
          },
          "author_response_ref": {
            "type": "string"
          }
        }
      }
    },
    "new_issues": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/issue"
          },
          {
            "type": "object",
            "required": [
              "why_new"
            ],
            "properties": {
              "why_new": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "position_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension",
          "from",
          "to",
          "reason"
        ],
        "properties": {
          "dimension": {
            "enum": [
              "overall",
              "novelty",
              "technical_soundness",
              "evidence_strength",
              "reproducibility",
              "clarity",
              "significance",
              "recommendation"
            ]
          },
          "from": {
            "type": [
              "string",
              "number"
            ]
          },
          "to": {
            "type": [
              "string",
              "number"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "remaining_concerns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sections_read",
        "truncated"
      ],
      "properties": {
        "sections_read": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sections_rechecked": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sections_provided": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "truncated": {
          "type": "boolean"
        },
        "omitted_sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "images_read": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "prompt_version": {
      "type": "string"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "highlights": {
      "type": "array",
      "description": "Innovation/technical/significance highlights. At least one is expected; empty with a reason in missing_evidence is a warning.",
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/highlight"
      }
    },
    "domain_assessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domain": {
          "type": "string"
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "score",
              "comment"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "score": {
                "type": "number",
                "minimum": 1,
                "maximum": 10
              },
              "comment": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/evidence"
                }
              }
            }
          }
        },
        "summary": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "round": {
            "minimum": 1
          }
        },
        "required": [
          "round"
        ]
      },
      "then": {
        "required": [
          "issue_updates",
          "new_issues",
          "position_changes",
          "remaining_concerns"
        ]
      }
    }
  ],
  "$defs": {
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall",
        "novelty",
        "technical_soundness",
        "evidence_strength",
        "reproducibility",
        "clarity",
        "significance"
      ],
      "properties": {
        "overall": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "novelty": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "technical_soundness": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "evidence_strength": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "reproducibility": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "clarity": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "significance": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "category",
        "severity",
        "claim",
        "why_it_matters",
        "requested_action",
        "evidence",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^R[0-9]{1,2}-I[0-9]{1,3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "category": {
          "enum": [
            "methodology",
            "theory",
            "experiments",
            "statistics",
            "novelty",
            "reproducibility",
            "clarity",
            "ethics",
            "related_work",
            "other"
          ]
        },
        "severity": {
          "enum": [
            "blocking",
            "major",
            "minor",
            "question",
            "nit"
          ]
        },
        "claim_type": {
          "enum": [
            "paper_claim",
            "reviewer_inference",
            "external_knowledge"
          ]
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "why_it_matters": {
          "type": "string",
          "minLength": 1
        },
        "requested_action": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "related_issue_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(R[0-9]{1,2}-I[0-9]{1,3}|I-[0-9]{3})$"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "enum": [
            "open",
            "responded",
            "resolved",
            "partially_resolved",
            "disputed",
            "withdrawn",
            "out_of_scope"
          ]
        },
        "why_new": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "paper",
            "absence",
            "external"
          ]
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "page_end": {
          "type": "integer",
          "minimum": 1
        },
        "section": {
          "type": "string",
          "maxLength": 120
        },
        "quote": {
          "type": "string",
          "maxLength": 600
        },
        "note": {
          "type": "string",
          "maxLength": 600
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "paper"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "page",
              "quote"
            ],
            "properties": {
              "quote": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "absence"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "page",
              "note"
            ],
            "properties": {
              "note": {
                "minLength": 5
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "external"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "note"
            ],
            "properties": {
              "note": {
                "minLength": 5
              }
            }
          }
        }
      ]
    },
    "highlight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "claim",
        "evidence",
        "why_it_matters"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^R[0-9]{1,2}-H[0-9]{1,3}$"
        },
        "kind": {
          "enum": [
            "innovation",
            "technical",
            "significance",
            "methodological"
          ]
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "why_it_matters": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}