{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpe.local/schemas/v2/rebuttal.schema.json",
  "title": "HPE Author Rebuttal",
  "description": "Author response to canonical ledger issues. The author cannot mark reviewer issues resolved and cannot introduce results that are not in the paper.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "paper_id",
    "author_id",
    "round",
    "responses",
    "revision_plan",
    "unresolved"
  ],
  "properties": {
    "schema_version": { "const": "hpe/v2" },
    "paper_id": { "type": "string", "minLength": 1 },
    "author_id": { "type": "string", "pattern": "^A[0-9]{1,2}$" },
    "round": { "type": "integer", "minimum": 1, "maximum": 5 },
    "responses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue_id", "status", "response", "paper_evidence", "confidence"],
        "properties": {
          "response_id": { "type": "string", "pattern": "^A[0-9]{1,2}-(R[0-9]{1,2}-I[0-9]{1,3}|I-[0-9]{3})$" },
          "issue_id": { "type": "string", "pattern": "^(R[0-9]{1,2}-I[0-9]{1,3}|I-[0-9]{3})$" },
          "status": { "enum": ["accept", "partially_accept", "clarify", "reject"] },
          "response": { "type": "string", "minLength": 1, "maxLength": 6000 },
          "paper_evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
          "revision_plan": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "global_clarifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "response"],
        "properties": {
          "topic": { "type": "string" },
          "response": { "type": "string" },
          "paper_evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
        }
      }
    },
    "new_claims": {
      "type": "array",
      "description": "Claims the author asserts are already in the paper but reviewers missed. Every entry must be supported by paper_evidence in the response; otherwise it is ignored by meta review.",
      "items": { "type": "string" }
    },
    "revision_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue_id", "action", "location", "effort"],
        "properties": {
          "issue_id": { "type": "string", "pattern": "^(R[0-9]{1,2}-I[0-9]{1,3}|I-[0-9]{3})$" },
          "action": { "type": "string", "minLength": 1 },
          "location": { "type": "string" },
          "effort": { "enum": ["small", "medium", "large"] }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(R[0-9]{1,2}-I[0-9]{1,3}|I-[0-9]{3})$" }
    },
    "prompt_version": { "type": "string" },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["paper", "absence", "external"] },
        "page": { "type": "integer", "minimum": 1 },
        "page_end": { "type": "integer", "minimum": 1 },
        "section": { "type": "string", "maxLength": 120 },
        "quote": { "type": "string", "maxLength": 600 },
        "note": { "type": "string", "maxLength": 600 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "paper" } }, "required": ["kind"] },
          "then": { "required": ["page", "quote"], "properties": { "quote": { "minLength": 1 } } }
        },
        {
          "if": { "properties": { "kind": { "const": "absence" } }, "required": ["kind"] },
          "then": { "required": ["page", "note"], "properties": { "note": { "minLength": 5 } } }
        },
        {
          "if": { "properties": { "kind": { "const": "external" } }, "required": ["kind"] },
          "then": { "required": ["note"], "properties": { "note": { "minLength": 5 } } }
        }
      ]
    }
  }
}
